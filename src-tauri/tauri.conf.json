{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Parrot",
  "version": "0.2.0",
  "identifier": "io.github.qwertymuzaffar.parrot",
  "build": {
    "frontendDist": "../dist/parrot/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Parrot",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD-PARTY-NOTICES": "THIRD-PARTY-NOTICES"
    },
    "category": "Education",
    "shortDescription": "Read a text aloud and see which words came out wrong",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "mainBinaryName": "Parrot"
}